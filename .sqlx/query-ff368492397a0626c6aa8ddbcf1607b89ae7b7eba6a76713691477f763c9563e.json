  "query": "SELECT public_ref::text AS \"id!\", created_at, expires_at,\n                  (verifier = $1) AS \"current!\"\n           FROM sessions\n           WHERE account_id = $2 AND generation = $3 AND revoked = FALSE AND expires_at > $4\n           ORDER BY created_at DESC, public_ref DESC LIMIT 33",
